(begin
  (let vec3 (fn (x y z) (list "vec3" x y z)))
  (let lerp (fn (a b t) (add a (mul (sub b a) t))))
  (let move_between
    (fn (startX startZ targetX targetZ progress)
      (list
        (lerp startX targetX progress)
        (lerp startZ targetZ progress)
      )
    )
  )

  (let agent
    (fn (id x z target color team)
      (list
        "type" "agent"
        "id" id
        "x" x
        "y" 1
        "z" z
        "target" target
        "color" color
        "team" team
      )
    )
  )

  (let role_agent
    (fn (id x z target color role team)
      (list
        "type" "agent"
        "id" id
        "x" x
        "y" 1
        "z" z
        "target" target
        "color" color
        "role" role
        "team" team
      )
    )
  )

  (let dragon_flight
    (fn (id baseX baseZ phase scale colorA colorB team)
      (list
        "type" "dragon_flight"
        "id" id
        "baseX" baseX
        "baseZ" baseZ
        "phase" phase
        "scale" scale
        "colorA" colorA
        "colorB" colorB
        "team" team
      )
    )
  )

  (let location
    (fn (id x z color)
      (list "type" "location" "id" id "x" x "y" 0.08 "z" z "color" color)
    )
  )

  (let floor
    (fn (w d color)
      (list "type" "floor" "id" "floor" "x" 0 "y" 0 "z" 0 "w" w "d" d "color" color)
    )
  )

  (let light
    (fn (id x y z intensity color)
      (list "type" "light" "id" id "x" x "y" y "z" z "intensity" intensity "color" color)
    )
  )

  (let camera
    (fn (x y z tx ty tz)
      (list "type" "camera" "id" "camera" "x" x "y" y "z" z "tx" tx "ty" ty "tz" tz)
    )
  )

  (let scene (fn (objects) objects))
)
