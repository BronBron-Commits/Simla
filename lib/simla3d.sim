(begin
  (let vec3
    (fn (x y z)
      (list "vec3" x y z)
    )
  )

  (let cube
    (fn (id x y z size color)
      (list
        "type" "cube"
        "id" id
        "x" x
        "y" y
        "z" z
        "size" size
        "color" color
      )
    )
  )

  (let box
    (fn (id x y z w h d color)
      (list
        "type" "box"
        "id" id
        "x" x
        "y" y
        "z" z
        "w" w
        "h" h
        "d" d
        "color" color
      )
    )
  )

  (let person
    (fn (id x z color)
      (list
        "type" "person"
        "id" id
        "x" x
        "y" 1
        "z" z
        "color" color
      )
    )
  )

  (let building
    (fn (id x z w h d color)
      (box id x (mul h 0.5) z w h d color)
    )
  )

  (let mall
    (fn (id x z)
      (building id x z 8 4 8 "#999999")
    )
  )

  (let house
    (fn (id x z)
      (building id x z 3 2.5 3 "#775533")
    )
  )

  (let shop
    (fn (id x z)
      (building id x z 4 3 3 "#446688")
    )
  )

  (let floor
    (fn (w d color)
      (list
        "type" "floor"
        "id" "floor"
        "x" 0
        "y" 0
        "z" 0
        "w" w
        "d" d
        "color" color
      )
    )
  )

  (let camera
    (fn (x y z tx ty tz)
      (list
        "type" "camera"
        "id" "camera"
        "x" x
        "y" y
        "z" z
        "tx" tx
        "ty" ty
        "tz" tz
      )
    )
  )

  (let light
    (fn (id x y z intensity color)
      (list
        "type" "light"
        "id" id
        "x" x
        "y" y
        "z" z
        "intensity" intensity
        "color" color
      )
    )
  )

  (let scene
    (fn (objects)
      objects
    )
  )
)
