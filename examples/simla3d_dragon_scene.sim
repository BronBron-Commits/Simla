(begin
  (import "../lib/simla3d.sim")

  (let t (mul tick 0.001))
  (let wingBeat (sin (mul t 5)))
  (let tailWave (sin (mul t 2.2)))
  (let breathe (sin (mul t 1.5)))
  (let hoverY (add 8 (mul (sin (mul t 1.2)) 0.7)))

  (scene
    (list
      (floor 120 120 "#2f4f2f")

      ;; shadow on ground
      (box "dragon_shadow" 0 0.04 0 9 0.04 13 "#172617")

      ;; flying dragon body
      (box "dragon_body" 0 hoverY 0 6 2.2 10 "#244c2a")
      (box "dragon_chest" 0 (add hoverY (add 0.15 (mul breathe 0.08))) -3.2 4.2 2.4 3.4 "#2a5f31")

      ;; centered neck and head
      (box "dragon_neck" 0 (add hoverY 0.9) -6.0 1.6 1.5 3.4 "#2e6534")
      (box "dragon_head" 0 (add hoverY 1.15) -8.5 2.7 1.8 2.4 "#356f39")
      (box "dragon_snout" 0 (add hoverY 0.95) -10.0 1.7 0.9 1.7 "#2c5a30")

      ;; horns
      (box "dragon_horn_l" -0.9 (add hoverY 2.15) -8.7 0.35 1.1 0.35 "#ddddbb")
      (box "dragon_horn_r" 0.9 (add hoverY 2.15) -8.7 0.35 1.1 0.35 "#ddddbb")

      ;; eyes
      (box "dragon_eye_l" -0.6 (add hoverY 1.48) -10.85 0.28 0.28 0.08 "#ffdd44")
      (box "dragon_eye_r" 0.6 (add hoverY 1.48) -10.85 0.28 0.28 0.08 "#ffdd44")

      ;; tucked flying legs
      (box "dragon_leg_fl" -2.0 (sub hoverY 1.05) -3.0 0.9 1.4 0.9 "#214725")
      (box "dragon_leg_fr" 2.0 (sub hoverY 1.05) -3.0 0.9 1.4 0.9 "#214725")
      (box "dragon_leg_bl" -2.0 (sub hoverY 1.05) 3.2 0.9 1.4 0.9 "#214725")
      (box "dragon_leg_br" 2.0 (sub hoverY 1.05) 3.2 0.9 1.4 0.9 "#214725")

      ;; tail follows behind, waving while airborne
      (box "dragon_tail_1" 0 (sub hoverY 0.25) (add 6.4 (mul tailWave 0.25)) 2.2 1.3 3.5 "#285c30")
      (box "dragon_tail_2" 0 (sub hoverY 0.65) (add 9.0 (mul tailWave 0.45)) 1.4 1.0 3.2 "#244c2a")
      (box "dragon_tail_3" 0 (sub hoverY 0.95) (add 11.3 (mul tailWave 0.65)) 0.8 0.7 2.6 "#1d4025")

      ;; big flapping wings
      (box "dragon_wing_l" -5.2 (add hoverY (mul wingBeat 1.6)) -0.8 7.2 0.25 8.5 "#1f3f29")
      (box "dragon_wing_r" 5.2 (add hoverY (mul wingBeat 1.6)) -0.8 7.2 0.25 8.5 "#1f3f29")

      ;; fire breath
      (box "dragon_fire_1" 0 (add hoverY 0.6) -12.0 1.2 0.6 2.4 "#ff7a22")
      (box "dragon_fire_2" 0 (add hoverY 0.4) -14.0 1.8 0.8 2.8 "#ffcc33")
      (box "dragon_fire_3" 0 (add hoverY 0.2) -16.4 2.5 1.0 3.0 "#ff3b1f")

      (light "sun" -8 20 8 1.4 "#ffffff")
      (camera 18 14 30 0 8 0)
    )
  )
)
