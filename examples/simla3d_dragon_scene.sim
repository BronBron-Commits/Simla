(begin
  (import "../lib/simla3d.sim")

  (let t (mul tick 0.001))

  (let dragon_fly
    (fn (id x z phase colorA colorB)
      (begin
        (let speedX (add 0.35 (mul (sin (add phase 1)) 0.15)))
        (let speedZ (add 0.30 (mul (cos (add phase 2)) 0.12)))

        (let fx (add x (mul (sin (add phase (mul t speedX))) 4)))
        (let fz (add z (mul (cos (add phase (mul t speedZ))) 3)))
        (let fy (add 8 (mul (sin (add phase (mul t 1.2))) 1.4)))

        (let vx (mul (cos (add phase (mul t speedX))) 4))
        (let vz (mul -1 (mul (sin (add phase (mul t speedZ))) 3)))
        (let heading (atan2 vx vz))

        (dragon id fx fy fz heading 0.55 colorA colorB)
      )
    )
  )

  (scene
    (list
      (floor 190 190 "#2f4f2f")
      (light "sun" -8 24 8 1.5 "#ffffff")
      (camera 42 28 68 0 8 0)

      (dragon_fly "dragon_01" 0 0 0 "#244c2a" "#2a5f31")
      (dragon_fly "dragon_02" 14 8 1 "#3e243f" "#5f2a5b")
      (dragon_fly "dragon_03" -16 8 2 "#243a4c" "#2a4c5f")
      (dragon_fly "dragon_04" 24 -12 3 "#4c2f24" "#6f3f2a")
      (dragon_fly "dragon_05" -26 -12 4 "#3d4c24" "#5a6f2a")
      (dragon_fly "dragon_06" 6 24 5 "#4c2440" "#6f2a5a")
      (dragon_fly "dragon_07" -12 28 6 "#223f32" "#2a5f4a")
      (dragon_fly "dragon_08" 34 20 7 "#32244c" "#4a2a6f")
      (dragon_fly "dragon_09" -36 18 8 "#4c4424" "#6f632a")
      (dragon_fly "dragon_10" 0 -30 9 "#24324c" "#2a3f6f")
    )
  )
)
