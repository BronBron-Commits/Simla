(begin
  (import "../lib/simla3d.sim")

  (let t (mul tick 0.001))

  ;; flight motion
  (let flightX (mul (sin (mul t 0.7)) 4))
  (let flightZ (mul (cos (mul t 0.45)) 3))
  (let hoverY (add 8 (mul (sin (mul t 1.2)) 0.7)))

  ;; body motion
  (let wingBeat (sin (mul t 7)))
  (let tailWave (sin (mul t 2.4)))
  (let breathe (sin (mul t 1.6)))
  (let headBob (sin (mul t 1.9)))
  (let firePulse (mul 0.5 (add 1 (sin (mul t 5)))))

  (scene
    (list
      (floor 120 120 "#2f4f2f")

      ;; moving shadow
      (box "dragon_shadow" flightX 0.04 flightZ 9 0.04 13 "#172617")

      ;; flying dragon body
      (box "dragon_body" flightX hoverY flightZ 6 2.2 10 "#244c2a")
      (box "dragon_chest" flightX (add hoverY (add 0.15 (mul breathe 0.14))) (sub flightZ 3.2) 4.2 2.4 3.4 "#2a5f31")

      ;; head/neck bob
      (box "dragon_neck" flightX (add hoverY (add 0.9 (mul headBob 0.25))) (sub flightZ 6.0) 1.6 1.5 3.4 "#2e6534")
      (box "dragon_head" flightX (add hoverY (add 1.15 (mul headBob 0.35))) (sub flightZ 8.5) 2.7 1.8 2.4 "#356f39")
      (box "dragon_snout" flightX (add hoverY (add 0.95 (mul headBob 0.35))) (sub flightZ 10.0) 1.7 0.9 1.7 "#2c5a30")

      ;; horns
      (box "dragon_horn_l" (sub flightX 0.9) (add hoverY (add 2.15 (mul headBob 0.35))) (sub flightZ 8.7) 0.35 1.1 0.35 "#ddddbb")
      (box "dragon_horn_r" (add flightX 0.9) (add hoverY (add 2.15 (mul headBob 0.35))) (sub flightZ 8.7) 0.35 1.1 0.35 "#ddddbb")

      ;; eyes
      (box "dragon_eye_l" (sub flightX 0.6) (add hoverY (add 1.48 (mul headBob 0.35))) (sub flightZ 10.85) 0.28 0.28 0.08 "#ffdd44")
      (box "dragon_eye_r" (add flightX 0.6) (add hoverY (add 1.48 (mul headBob 0.35))) (sub flightZ 10.85) 0.28 0.28 0.08 "#ffdd44")

      ;; tucked flying legs
      (box "dragon_leg_fl" (sub flightX 2.0) (sub hoverY 1.05) (sub flightZ 3.0) 0.9 1.4 0.9 "#214725")
      (box "dragon_leg_fr" (add flightX 2.0) (sub hoverY 1.05) (sub flightZ 3.0) 0.9 1.4 0.9 "#214725")
      (box "dragon_leg_bl" (sub flightX 2.0) (sub hoverY 1.05) (add flightZ 3.2) 0.9 1.4 0.9 "#214725")
      (box "dragon_leg_br" (add flightX 2.0) (sub hoverY 1.05) (add flightZ 3.2) 0.9 1.4 0.9 "#214725")

      ;; animated tail
      (box "dragon_tail_1" flightX (sub hoverY 0.25) (add flightZ (add 6.4 (mul tailWave 0.5))) 2.2 1.3 3.5 "#285c30")
      (box "dragon_tail_2" flightX (sub hoverY 0.65) (add flightZ (add 9.0 (mul tailWave 0.9))) 1.4 1.0 3.2 "#244c2a")
      (box "dragon_tail_3" flightX (sub hoverY 0.95) (add flightZ (add 11.3 (mul tailWave 1.2))) 0.8 0.7 2.6 "#1d4025")

      ;; flapping wings
      (box "dragon_wing_l" (sub flightX 5.2) (add hoverY (mul wingBeat 1.9)) (sub flightZ 0.8) 7.2 0.25 8.5 "#1f3f29")
      (box "dragon_wing_r" (add flightX 5.2) (add hoverY (mul wingBeat 1.9)) (sub flightZ 0.8) 7.2 0.25 8.5 "#1f3f29")

      ;; pulsing fire
      (box "dragon_fire_1" flightX (add hoverY 0.6) (sub flightZ 12.0) (add 0.8 (mul firePulse 0.6)) 0.6 2.4 "#ff7a22")
      (box "dragon_fire_2" flightX (add hoverY 0.4) (sub flightZ 14.0) (add 1.2 (mul firePulse 1.0)) 0.8 2.8 "#ffcc33")
      (box "dragon_fire_3" flightX (add hoverY 0.2) (sub flightZ 16.4) (add 1.8 (mul firePulse 1.4)) 1.0 3.0 "#ff3b1f")

      (light "sun" -8 20 8 1.4 "#ffffff")
      (camera 18 14 30 0 8 0)
    )
  )
)
