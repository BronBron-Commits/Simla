(concat

  ;; room 1 floor
  (map
    (fn (x)
      (list
        "type" "cube"
        "x" x
        "y" -1
        "z" -20
        "sx" 2
        "sy" 0.5
        "sz" 2
        "r" 80
        "g" 80
        "b" 90
      )
    )
    (range -20 20)
  )

  ;; corridor
  (map
    (fn (x)
      (list
        "type" "cube"
        "x" x
        "y" -0.5
        "z" 0
        "sx" 1
        "sy" 1
        "sz" 1
        "r" 180
        "g" 140
        "b" 90
      )
    )
    (range -20 20)
  )

  ;; room 2 floor
  (map
    (fn (x)
      (list
        "type" "cube"
        "x" x
        "y" -1
        "z" 20
        "sx" 2
        "sy" 0.5
        "sz" 2
        "r" 80
        "g" 80
        "b" 90
      )
    )
    (range -20 20)
  )
)
