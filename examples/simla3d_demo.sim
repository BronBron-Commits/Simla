(begin
  (import "../lib/simla3d.sim")

  (let t (mul tick 0.001))

  (let mallX 10)
  (let mallZ 8)

  (let shopX 0)
  (let shopZ -8)

  (let homeAX -10)
  (let homeAZ -8)

  (let homeBX -6)
  (let homeBZ -10)

  (let aliceX (add -10 (sin t)))
  (let aliceZ -4)

  (let bobX -4)
  (let bobZ (add -4 (cos t)))

  (let caraX (add 4 (sin (mul t 0.5))))
  (let caraZ 2)

  (let daveX 8)
  (let daveZ (add 4 (cos (mul t 0.75))))

  (let erinX (add 10 (sin (mul t 1.25))))
  (let erinZ 10)

  (scene
    (list
      (floor 64 64 "#203020")

      (house "home_a" homeAX homeAZ)
      (house "home_b" homeBX homeBZ)
      (shop "corner_shop" shopX shopZ)
      (mall "big_mall" mallX mallZ)

      (location "home_a_marker" homeAX homeAZ "#ffaa66")
      (location "home_b_marker" homeBX homeBZ "#ffaa66")
      (location "shop_marker" shopX shopZ "#66aaff")
      (location "mall_marker" mallX mallZ "#ddddff")

      (agent "alice" aliceX aliceZ "big_mall" "#55ccff")
      (agent "bob" bobX bobZ "corner_shop" "#ffaa44")
      (agent "cara" caraX caraZ "home_a" "#ff66cc")
      (agent "dave" daveX daveZ "big_mall" "#99ff99")
      (agent "erin" erinX erinZ "home_b" "#ddddff")

      (route "alice_route" aliceX aliceZ mallX mallZ "#55ccff")
      (route "bob_route" bobX bobZ shopX shopZ "#ffaa44")
      (route "cara_route" caraX caraZ homeAX homeAZ "#ff66cc")
      (route "dave_route" daveX daveZ mallX mallZ "#99ff99")
      (route "erin_route" erinX erinZ homeBX homeBZ "#ddddff")

      (light "sun" 4 14 4 1.2 "#ffffff")
      (camera 20 16 28 0 0 0)
    )
  )
)
