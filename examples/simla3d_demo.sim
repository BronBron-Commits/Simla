(begin
  (import "../lib/simla3d.sim")

  (let t (mul tick 0.001))

  ;; helper: oscillating 0..1
  (let p
    (fn (phase speed)
      (mul 0.5 (add 1 (sin (add phase (mul t speed)))))
    )
  )

  (let mv
    (fn (sx sz tx tz phase speed)
      (move_between sx sz tx tz (p phase speed))
    )
  )

  ;; hubs
  (let mallX 10)     (let mallZ 8)
  (let mall2X 34)    (let mall2Z 22)
  (let shopX 0)      (let shopZ -8)
  (let plazaX 2)     (let plazaZ 4)
  (let parkX -14)    (let parkZ 10)
  (let park2X 28)    (let park2Z -20)
  (let officeX 14)   (let officeZ -10)
  (let schoolX -2)   (let schoolZ 14)
  (let stationX -12) (let stationZ 20)

  ;; homes
  (let h1x -10) (let h1z -8)
  (let h2x -6)  (let h2z -10)
  (let h3x -16) (let h3z -4)
  (let h4x -18) (let h4z -10)
  (let h5x -20) (let h5z -2)
  (let h6x -14) (let h6z -14)
  (let h7x -24) (let h7z 5)
  (let h8x -18) (let h8z 14)
  (let h9x -26) (let h9z -6)
  (let h10x -22) (let h10z 12)

  ;; movers
  (let a1 (mv h1x h1z mallX mallZ 0 0.45))
  (let a2 (mv h2x h2z shopX shopZ 1 0.55))
  (let a3 (mv shopX shopZ h1x h1z 2 0.38))
  (let a4 (mv plazaX plazaZ mallX mallZ 3 0.62))
  (let a5 (mv mallX mallZ h2x h2z 4 0.44))
  (let a6 (mv schoolX schoolZ plazaX plazaZ 5 0.50))
  (let a7 (mv parkX parkZ mallX mallZ 6 0.35))
  (let a8 (mv officeX officeZ shopX shopZ 7 0.52))
  (let a9 (mv h3x h3z parkX parkZ 8 0.41))
  (let a10 (mv shopX shopZ schoolX schoolZ 9 0.57))
  (let a11 (mv h4x h4z plazaX plazaZ 10 0.47))
  (let a12 (mv h5x h5z mall2X mall2Z 11 0.43))
  (let a13 (mv h6x h6z shopX shopZ 12 0.49))
  (let a14 (mv h7x h7z parkX parkZ 13 0.36))
  (let a15 (mv h8x h8z schoolX schoolZ 14 0.58))
  (let a16 (mv h9x h9z plazaX plazaZ 15 0.46))
  (let a17 (mv h10x h10z mallX mallZ 16 0.42))
  (let a18 (mv plazaX plazaZ officeX officeZ 17 0.51))
  (let a19 (mv officeX officeZ mallX mallZ 18 0.39))
  (let a20 (mv park2X park2Z shopX shopZ 19 0.54))
  (let a21 (mv stationX stationZ mall2X mall2Z 20 0.37))
  (let a22 (mv mall2X mall2Z officeX officeZ 21 0.48))
  (let a23 (mv parkX parkZ schoolX schoolZ 22 0.40))
  (let a24 (mv h2x h2z stationX stationZ 23 0.53))

  (scene
    (list
      (floor 140 140 "#203020")

      ;; residential district
      (house "home_1" h1x h1z)
      (house "home_2" h2x h2z)
      (house "home_3" h3x h3z)
      (house "home_4" h4x h4z)
      (house "home_5" h5x h5z)
      (house "home_6" h6x h6z)
      (house "home_7" h7x h7z)
      (house "home_8" h8x h8z)
      (house "home_9" h9x h9z)
      (house "home_10" h10x h10z)
      (house "home_11" -30 2)
      (house "home_12" -30 10)
      (house "home_13" -28 -14)
      (house "home_14" -34 -6)

      ;; apartments, spaced out
      (building "apt_a" 18 -2 6 7 6 "#6c7080")
      (building "apt_b" 28 8 6 8 6 "#747080")
      (building "apt_c" 38 18 6 9 6 "#6f7285")
      (building "apt_d" 18 24 6 7 6 "#6b6f7f")
      (building "apt_e" 32 -8 6 8 6 "#70758a")
      (building "apt_f" 42 4 6 9 6 "#6d7288")
      (building "apt_g" 46 16 6 7 6 "#777b8f")
      (building "apt_h" 30 30 6 8 6 "#646c7e")

      ;; commercial core
      (shop "corner_shop" shopX shopZ)
      (shop "book_shop" 4 -12)
      (shop "arcade" 8 -6)
      (shop "cafe" -4 -2)
      (shop "market" 16 14)
      (mall "big_mall" mallX mallZ)
      (mall "north_mall" mall2X mall2Z)

      ;; civic / industrial
      (building "office_tower" officeX officeZ 6 10 6 "#667788")
      (building "school" schoolX schoolZ 8 3 6 "#886644")
      (building "plaza_center" plazaX plazaZ 5 1 5 "#777777")
      (building "warehouse" -6 20 10 4 7 "#555c66")
      (building "clinic" 8 18 6 3 5 "#dddddd")
      (building "station" stationX stationZ 7 3 5 "#445566")
      (building "factory" 26 -28 12 5 8 "#555555")
      (building "library" -8 28 7 4 5 "#8a7155")
      (building "hotel" 40 -18 7 11 7 "#81728a")
      (building "garage" 4 -24 9 3 7 "#4f5964")

      ;; parks as low green blocks/markers
      (building "central_park" parkX parkZ 10 0.2 8 "#2f7d46")
      (building "south_park" park2X park2Z 12 0.2 10 "#2f7d46")
      (location "park_marker" parkX parkZ "#66ff99")
      (location "south_park_marker" park2X park2Z "#66ff99")

      ;; markers
      (location "mall_marker" mallX mallZ "#ddddff")
      (location "north_mall_marker" mall2X mall2Z "#ddddff")
      (location "shop_marker" shopX shopZ "#66aaff")
      (location "plaza_marker" plazaX plazaZ "#ffee88")
      (location "office_marker" officeX officeZ "#aaccff")
      (location "school_marker" schoolX schoolZ "#ffcc88")
      (location "station_marker" stationX stationZ "#aaddee")

      ;; 24 moving agents
      (agent "a1" (nth a1 0) (nth a1 1) "big_mall" "#55ccff")
      (agent "a2" (nth a2 0) (nth a2 1) "corner_shop" "#ffaa44")
      (agent "a3" (nth a3 0) (nth a3 1) "home_1" "#ff66cc")
      (agent "a4" (nth a4 0) (nth a4 1) "big_mall" "#99ff99")
      (agent "a5" (nth a5 0) (nth a5 1) "home_2" "#ddddff")
      (agent "a6" (nth a6 0) (nth a6 1) "plaza_center" "#88ddff")
      (agent "a7" (nth a7 0) (nth a7 1) "big_mall" "#ff88aa")
      (agent "a8" (nth a8 0) (nth a8 1) "corner_shop" "#ccaa66")
      (agent "a9" (nth a9 0) (nth a9 1) "central_park" "#aa88ff")
      (agent "a10" (nth a10 0) (nth a10 1) "school" "#aaffaa")
      (agent "a11" (nth a11 0) (nth a11 1) "plaza_center" "#ffeeaa")
      (agent "a12" (nth a12 0) (nth a12 1) "north_mall" "#cceeff")
      (agent "a13" (nth a13 0) (nth a13 1) "corner_shop" "#ffccaa")
      (agent "a14" (nth a14 0) (nth a14 1) "central_park" "#ccffaa")
      (agent "a15" (nth a15 0) (nth a15 1) "school" "#aaccff")
      (agent "a16" (nth a16 0) (nth a16 1) "plaza_center" "#ddaaff")
      (agent "a17" (nth a17 0) (nth a17 1) "big_mall" "#aaffdd")
      (agent "a18" (nth a18 0) (nth a18 1) "office_tower" "#ddffaa")
      (agent "a19" (nth a19 0) (nth a19 1) "big_mall" "#ffddaa")
      (agent "a20" (nth a20 0) (nth a20 1) "corner_shop" "#aaddff")
      (agent "a21" (nth a21 0) (nth a21 1) "north_mall" "#ffaadd")
      (agent "a22" (nth a22 0) (nth a22 1) "office_tower" "#ddccff")
      (agent "a23" (nth a23 0) (nth a23 1) "school" "#bbffaa")
      (agent "a24" (nth a24 0) (nth a24 1) "station" "#ffbbbb")

      ;; mall crowd
      (agent "m01" 8 7 "big_mall" "#eeeeff")
      (agent "m02" 9 10 "big_mall" "#ffeeee")
      (agent "m03" 12 7 "big_mall" "#eeffee")
      (agent "m04" 13 10 "big_mall" "#ffffcc")
      (agent "m05" 10 12 "big_mall" "#ccffff")
      (agent "m06" 11 9 "big_mall" "#ffddee")
      (agent "m07" 9 6 "big_mall" "#ddffee")
      (agent "m08" 12 11 "big_mall" "#eeddff")
      (agent "m09" 14 8 "big_mall" "#ffeecc")
      (agent "m10" 7 9 "big_mall" "#ddeeff")
      (agent "m11" 10 6 "big_mall" "#eef2ff")
      (agent "m12" 11 12 "big_mall" "#f0ffee")
      (agent "m13" 13 6 "big_mall" "#ffeef5")
      (agent "m14" 8 12 "big_mall" "#e6fffa")
      (agent "m15" 12 9 "big_mall" "#fff0e6")

      ;; north mall crowd
      (agent "n01" 32 20 "north_mall" "#eeeeff")
      (agent "n02" 36 21 "north_mall" "#ffeeee")
      (agent "n03" 35 25 "north_mall" "#eeffee")
      (agent "n04" 31 24 "north_mall" "#ffffcc")
      (agent "n05" 38 23 "north_mall" "#ccffff")

      ;; park crowd
      (agent "p01" -15 9 "central_park" "#ccffaa")
      (agent "p02" -12 11 "central_park" "#aaffcc")
      (agent "p03" -17 12 "central_park" "#bbffbb")
      (agent "p04" 28 -21 "south_park" "#ccffaa")
      (agent "p05" 31 -18 "south_park" "#aaffcc")
      (agent "p06" 24 -22 "south_park" "#bbffbb")

      ;; extra street population
      (agent "s01" -6 -6 "corner_shop" "#cceeff")
      (agent "s02" -2 -10 "corner_shop" "#ffe0cc")
      (agent "s03" 3 -7 "corner_shop" "#e0ffcc")
      (agent "s04" 6 -9 "arcade" "#ffccdd")
      (agent "s05" 10 -5 "arcade" "#ddccff")
      (agent "s06" 13 -7 "office_tower" "#ccffee")
      (agent "s07" 16 -12 "office_tower" "#ffeeaa")
      (agent "s08" 18 -6 "office_tower" "#aaccff")

      ;; extra residential population
      (agent "r01" -12 -7 "home_1" "#f4d7c5")
      (agent "r02" -8 -11 "home_2" "#d7eaff")
      (agent "r03" -18 -5 "home_3" "#ffd7ef")
      (agent "r04" -20 -11 "home_4" "#eaffd7")
      (agent "r05" -22 -1 "home_5" "#fff3c4")
      (agent "r06" -16 -15 "home_6" "#d7fff7")
      (agent "r07" -26 4 "home_7" "#ead7ff")
      (agent "r08" -20 15 "home_8" "#ffe4d7")
      (agent "r09" -28 -7 "home_9" "#d7ffdf")
      (agent "r10" -24 13 "home_10" "#d7e1ff")

      ;; extra civic population
      (agent "c01" -3 13 "school" "#ffeecc")
      (agent "c02" 0 16 "school" "#ccffee")
      (agent "c03" -5 15 "school" "#e6ddff")
      (agent "c04" 7 17 "clinic" "#ffffff")
      (agent "c05" 10 19 "clinic" "#e8f7ff")
      (agent "c06" -13 21 "station" "#ddeeff")
      (agent "c07" -10 19 "station" "#ffddee")
      (agent "c08" -8 27 "library" "#fff0cc")
      (agent "c09" -5 29 "library" "#ddffef")
      (agent "c10" 3 5 "plaza_center" "#ffffdd")

      ;; extra north district population
      (agent "q01" 30 6 "apt_b" "#ddeeff")
      (agent "q02" 33 9 "apt_e" "#ffeedd")
      (agent "q03" 40 5 "apt_f" "#eeffdd")
      (agent "q04" 44 18 "apt_g" "#ffddf0")
      (agent "q05" 31 31 "apt_h" "#ddf7ff")
      (agent "q06" 39 -17 "hotel" "#f0ddff")
      (agent "q07" 42 -20 "hotel" "#ddfff2")
      (agent "q08" 25 -27 "factory" "#eeeeee")
      (agent "q09" 30 -29 "factory" "#dddddd")
      (agent "q10" 5 -23 "garage" "#ccddee")


      ;; routes
      (route "r1" (nth a1 0) (nth a1 1) mallX mallZ "#55ccff")
      (route "r2" (nth a2 0) (nth a2 1) shopX shopZ "#ffaa44")
      (route "r3" (nth a3 0) (nth a3 1) h1x h1z "#ff66cc")
      (route "r4" (nth a4 0) (nth a4 1) mallX mallZ "#99ff99")
      (route "r5" (nth a5 0) (nth a5 1) h2x h2z "#ddddff")
      (route "r6" (nth a6 0) (nth a6 1) plazaX plazaZ "#88ddff")
      (route "r7" (nth a7 0) (nth a7 1) mallX mallZ "#ff88aa")
      (route "r8" (nth a8 0) (nth a8 1) shopX shopZ "#ccaa66")
      (route "r9" (nth a9 0) (nth a9 1) parkX parkZ "#aa88ff")
      (route "r10" (nth a10 0) (nth a10 1) schoolX schoolZ "#aaffaa")
      (route "r11" (nth a11 0) (nth a11 1) plazaX plazaZ "#ffeeaa")
      (route "r12" (nth a12 0) (nth a12 1) mall2X mall2Z "#cceeff")
      (route "r13" (nth a13 0) (nth a13 1) shopX shopZ "#ffccaa")
      (route "r14" (nth a14 0) (nth a14 1) parkX parkZ "#ccffaa")
      (route "r15" (nth a15 0) (nth a15 1) schoolX schoolZ "#aaccff")
      (route "r16" (nth a16 0) (nth a16 1) plazaX plazaZ "#ddaaff")
      (route "r17" (nth a17 0) (nth a17 1) mallX mallZ "#aaffdd")
      (route "r18" (nth a18 0) (nth a18 1) officeX officeZ "#ddffaa")
      (route "r19" (nth a19 0) (nth a19 1) mallX mallZ "#ffddaa")
      (route "r20" (nth a20 0) (nth a20 1) shopX shopZ "#aaddff")
      (route "r21" (nth a21 0) (nth a21 1) mall2X mall2Z "#ffaadd")
      (route "r22" (nth a22 0) (nth a22 1) officeX officeZ "#ddccff")
      (route "r23" (nth a23 0) (nth a23 1) schoolX schoolZ "#bbffaa")
      (route "r24" (nth a24 0) (nth a24 1) stationX stationZ "#ffbbbb")


      ;; high-flying dragons above the city
      (dragon_flight "city_dragon_01" 0 0 0 0.45 "#244c2a" "#2a5f31")
      (dragon_flight "city_dragon_02" 28 18 2 0.42 "#243a4c" "#2a4c5f")
      (dragon_flight "city_dragon_03" -24 -12 4 0.40 "#4c2f24" "#6f3f2a")

      (light "sun" 4 18 4 1.3 "#ffffff")
      (camera 42 32 58 4 0 4)
    )
  )
)
