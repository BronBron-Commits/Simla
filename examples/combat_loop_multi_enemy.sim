(begin
  ;; Headless Simλ combat loop: entity-list version
  ;;
  ;; Host inputs:
  ;; state
  ;; actionType: "move" | "attack" | "end"
  ;; actorId
  ;; targetId
  ;; actionTile

  (let entities (get state "entities"))

  ;; v1 helpers are explicit because this test starts with fixed ids.
  (let player (nth entities 0))
  (let enemy2 (nth entities 1))
  (let enemy3 (nth entities 2))
  (let enemy4 (nth entities 3))

  (let enemy
    (if (eq targetId 3)
      enemy3
      (if (eq targetId 4)
        enemy4
        enemy2
      )
    )
  )

  (let playerHp (get player "hp"))
  (let enemyHp (get enemy "hp"))

  (let playerTile (get player "tile"))
  (let enemyTile (get enemy "tile"))

  (let playerAttack (get player "attack"))
  (let enemyAttack (get enemy "attack"))

  (let playerMoveRange (get player "move"))
  (let attackRange 1)

  ;; Board tile format:
  ;; (id blocked danger moveCost)
  (let board
    (list
      (list 0 0 0 1)
      (list 1 0 0 1)
      (list 2 0 0 1)
      (list 3 0 1 1)
      (list 4 0 0 1)
      (list 5 1 0 99)
      (list 6 0 0 1)
      (list 7 0 0 1)
      (list 8 0 0 1)
      (list 9 0 0 1)
      (list 10 0 0 1)
      (list 11 0 0 1)
      (list 12 0 0 1)
      (list 13 0 0 1)
      (list 14 0 0 1)
      (list 15 0 0 1)
    )
  )

  (let selectedTile actionTile)
  (let selectedData (nth board selectedTile))
  (let selectedBlocked (nth selectedData 1))

  (let moveLeftLimit (sub playerTile playerMoveRange))
  (let moveRightLimit (add playerTile playerMoveRange))

  (let selectedTooFarLeft (lt selectedTile moveLeftLimit))
  (let selectedTooFarRight (gt selectedTile moveRightLimit))
  (let selectedIsEnemy (eq selectedTile enemyTile))

  (let distA (sub playerTile enemyTile))
  (let distB (sub enemyTile playerTile))
  (let distance (if (lt distA 0) distB distA))
  (let adjacent (if (gt distance attackRange) 0 1))

  (let isMove (eq actionType "move"))
  (let isAttack (eq actionType "attack"))
  (let isEnd (eq actionType "end"))

  ;; Player action resolution.
  (let canMove
    (if isMove
      (if selectedTooFarLeft
        0
        (if selectedTooFarRight
          0
          (if selectedIsEnemy
            0
            (if selectedBlocked
              0
              1
            )
          )
        )
      )
      0
    )
  )

  (let nextPlayerTile
    (if canMove
      selectedTile
      playerTile
    )
  )

  (let playerCanAttack
    (if isAttack
      (if adjacent
        (eq targetId (get enemy "id"))
        0
      )
      0
    )
  )

  (let enemyHpAfterPlayer
    (if playerCanAttack
      (sub enemyHp playerAttack)
      enemyHp
    )
  )

  (let enemyDead (if (gt enemyHpAfterPlayer 0) 0 1))

  ;; Enemy response on end turn.
  (let enemyDistA (sub nextPlayerTile enemyTile))
  (let enemyDistB (sub enemyTile nextPlayerTile))
  (let enemyDistance (if (lt enemyDistA 0) enemyDistB enemyDistA))
  (let enemyAdjacent (if (gt enemyDistance attackRange) 0 1))

  (let enemyActs
    (if isEnd
      (if enemyDead 0 1)
      0
    )
  )

  (let enemyAttacks
    (if enemyActs
      enemyAdjacent
      0
    )
  )

  (let enemy3Tile (get enemy3 "tile"))
  (let enemy4Tile (get enemy4 "tile"))

  (let enemy3DistA (sub nextPlayerTile enemy3Tile))
  (let enemy3DistB (sub enemy3Tile nextPlayerTile))
  (let enemy3Distance (if (lt enemy3DistA 0) enemy3DistB enemy3DistA))
  (let enemy3Adjacent (if (gt enemy3Distance attackRange) 0 1))

  (let enemy4DistA (sub nextPlayerTile enemy4Tile))
  (let enemy4DistB (sub enemy4Tile nextPlayerTile))
  (let enemy4Distance (if (lt enemy4DistA 0) enemy4DistB enemy4DistA))
  (let enemy4Adjacent (if (gt enemy4Distance attackRange) 0 1))

  (let enemy3Attacks
    (if isEnd
      (if (get enemy3 "dead") 0 enemy3Adjacent)
      0
    )
  )

  (let enemy4Attacks
    (if isEnd
      (if (get enemy4 "dead") 0 enemy4Adjacent)
      0
    )
  )

  (let totalEnemyDamage
    (add
      (if enemyAttacks enemyAttack 0)
      (add
        (if enemy3Attacks (get enemy3 "attack") 0)
        (if enemy4Attacks (get enemy4 "attack") 0)
      )
    )
  )

  (let playerHpAfterEnemy
    (if isEnd
      (sub playerHp totalEnemyDamage)
      playerHp
    )
  )

  (let playerDead (if (gt playerHpAfterEnemy 0) 0 1))

  (let enemyStepToward
    (if (lt enemyTile nextPlayerTile)
      (add enemyTile 1)
      (if (gt enemyTile nextPlayerTile)
        (sub enemyTile 1)
        enemyTile
      )
    )
  )

  (let enemyStepData (nth board enemyStepToward))
  (let enemyStepBlocked (nth enemyStepData 1))

  (let nextEnemyTile
    (if enemyActs
      (if enemyAttacks
        enemyTile
        (if enemyStepBlocked
          enemyTile
          enemyStepToward
        )
      )
      enemyTile
    )
  )

  (let nextPlayer
    (list
      "id" (get player "id")
      "team" (get player "team")
      "hp" playerHpAfterEnemy
      "tile" nextPlayerTile
      "attack" playerAttack
      "move" playerMoveRange
      "dead" playerDead
    )
  )

  (let nextEnemy
    (list
      "id" (get enemy "id")
      "team" (get enemy "team")
      "hp" enemyHpAfterPlayer
      "tile" nextEnemyTile
      "attack" enemyAttack
      "move" (get enemy "move")
      "dead" enemyDead
    )
  )

  ;; Enemy 3/4 basic end-turn chase.
  ;; Enemy 2 still uses the existing single-enemy attack/move logic above.

  (let enemy3Step
    (if (lt enemy3Tile nextPlayerTile)
      (add enemy3Tile 1)
      (if (gt enemy3Tile nextPlayerTile)
        (sub enemy3Tile 1)
        enemy3Tile
      )
    )
  )

  (let enemy4Step
    (if (lt enemy4Tile nextPlayerTile)
      (add enemy4Tile 1)
      (if (gt enemy4Tile nextPlayerTile)
        (sub enemy4Tile 1)
        enemy4Tile
      )
    )
  )

  (let nextEnemy3Tile
    (if isEnd
      (if (get enemy3 "dead")
        enemy3Tile
        (if enemy3Attacks enemy3Tile enemy3Step)
      )
      enemy3Tile
    )
  )

  (let nextEnemy4Tile
    (if isEnd
      (if (get enemy4 "dead")
        enemy4Tile
        (if enemy4Attacks enemy4Tile enemy4Step)
      )
      enemy4Tile
    )
  )

  (let nextEnemy2
    (if (eq targetId 2) nextEnemy enemy2)
  )

  (let enemy3AfterAttack
    (if (eq targetId 3) nextEnemy enemy3)
  )

  (let enemy4AfterAttack
    (if (eq targetId 4) nextEnemy enemy4)
  )

  (let nextEnemy3
    (list
      "id" (get enemy3AfterAttack "id")
      "team" (get enemy3AfterAttack "team")
      "hp" (get enemy3AfterAttack "hp")
      "tile" nextEnemy3Tile
      "attack" (get enemy3AfterAttack "attack")
      "move" (get enemy3AfterAttack "move")
      "dead" (get enemy3AfterAttack "dead")
    )
  )

  (let nextEnemy4
    (list
      "id" (get enemy4AfterAttack "id")
      "team" (get enemy4AfterAttack "team")
      "hp" (get enemy4AfterAttack "hp")
      "tile" nextEnemy4Tile
      "attack" (get enemy4AfterAttack "attack")
      "move" (get enemy4AfterAttack "move")
      "dead" (get enemy4AfterAttack "dead")
    )
  )

  (let nextEntities (list nextPlayer nextEnemy2 nextEnemy3 nextEnemy4))

  (let moveEvent
    (if canMove
      (list (list "move" (get player "id") playerTile nextPlayerTile))
      (list)
    )
  )

  (let attackEvent
    (if playerCanAttack
      (list (list "attack" (get player "id") (get enemy "id") playerAttack))
      (list)
    )
  )

  (let enemyAttackEvent
    (concat
      (if enemyAttacks
        (list (list "attack" (get enemy "id") (get player "id") enemyAttack))
        (list)
      )
      (concat
        (if enemy3Attacks
          (list (list "attack" (get enemy3 "id") (get player "id") (get enemy3 "attack")))
          (list)
        )
        (if enemy4Attacks
          (list (list "attack" (get enemy4 "id") (get player "id") (get enemy4 "attack")))
          (list)
        )
      )
    )
  )

  (let enemyMoveEvent
    (concat
      (if enemyActs
        (if enemyAttacks
          (list)
          (list (list "move" (get enemy "id") enemyTile nextEnemyTile))
        )
        (list)
      )
      (concat
        (if isEnd
          (if (get enemy3 "dead")
            (list)
            (if enemy3Attacks
              (list)
              (list (list "move" (get enemy3 "id") enemy3Tile nextEnemy3Tile))
            )
          )
          (list)
        )
        (if isEnd
          (if (get enemy4 "dead")
            (list)
            (if enemy4Attacks
              (list)
              (list (list "move" (get enemy4 "id") enemy4Tile nextEnemy4Tile))
            )
          )
          (list)
        )
      )
    )
  )

  (let targetWasDead (get enemy "dead"))

  (let deathEvent
    (if enemyDead
      (if targetWasDead
        (list)
        (list (list "death" (get enemy "id")))
      )
      (if playerDead
        (list (list "death" (get player "id")))
        (list)
      )
    )
  )

  (let events
    (concat
      moveEvent
      (concat
        attackEvent
        (concat
          enemyAttackEvent
          (concat enemyMoveEvent deathEvent)
        )
      )
    )
  )

  (let allEnemiesDead
    (if (get nextEnemy2 "dead")
      (if (get nextEnemy3 "dead")
        (if (get nextEnemy4 "dead")
          1
          0
        )
        0
      )
      0
    )
  )

  (list
    "state"
      (list
        "entities" nextEntities
        "round" (get state "round")
      )

    "result"
      (if playerDead
        "defeat"
        (if allEnemiesDead
          "victory"
          "ongoing"
        )
      )

    "events" events

    "debug"
      (list
        "actionType" actionType
        "actorId" actorId
        "targetId" targetId
        "actionTile" actionTile
        "canMove" canMove
        "playerCanAttack" playerCanAttack
        "enemyActs" enemyActs
        "enemyAttacks" totalEnemyDamage
      )
  )
)
