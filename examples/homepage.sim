(begin
  (page
    (list
      (theme "dark" "cyan")

      (hero
        "Simλ"
        "A deterministic functional language for simulation and procedural worlds."
      )

      (button "Read the Spec" "docs.html")

      (cards
        (list
          (card "Deterministic" "Same input, same output.")
          (card "Functional" "map, filter, reduce, recursion.")
          (card "Visual" "Scenes, combat, animation, and rendering.")
        )
      )

      (code
        "map fn x mul x 2 list 1 2 3"
      )
    )
  )
)
