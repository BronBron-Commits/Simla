(begin
  (let PUSH 1)
  (let ADD 2)
  (let MUL 3)

  (let NUMBER 0)
  (let ADD_NODE 1)
  (let MUL_NODE 2)

  (let top
    (fn (xs)
      (nth xs (sub (len xs) 1))
    )
  )

  (let drop2
    (fn (xs)
      (slice xs 0 (sub (len xs) 2))
    )
  )

  (let compile
    (fn (node)
      (if
        (eq (nth node 0) NUMBER)

        (list PUSH (nth node 1))

        (if
          (eq (nth node 0) ADD_NODE)

          (concat
            (concat
              (compile (nth node 1))
              (compile (nth node 2))
            )
            (list ADD)
          )

          (concat
            (concat
              (compile (nth node 1))
              (compile (nth node 2))
            )
            (list MUL)
          )
        )
      )
    )
  )

  (let exec
    (fn (code stack ip)
      (if
        (eq ip (len code))

        (top stack)

        (if
          (eq (nth code ip) PUSH)

          (exec
            code
            (append stack (nth code (add ip 1)))
            (add ip 2)
          )

          (if
            (eq (nth code ip) ADD)

            (exec
              code
              (append
                (drop2 stack)
                (add
                  (nth stack (sub (len stack) 2))
                  (nth stack (sub (len stack) 1))
                )
              )
              (add ip 1)
            )

            (exec
              code
              (append
                (drop2 stack)
                (mul
                  (nth stack (sub (len stack) 2))
                  (nth stack (sub (len stack) 1))
                )
              )
              (add ip 1)
            )
          )
        )
      )
    )
  )

  (let ast
    (list
      MUL_NODE
      (list ADD_NODE (list NUMBER 2) (list NUMBER 3))
      (list NUMBER 4)
    )
  )

  (exec (compile ast) (list) 0)
)
