(begin
  ;; Stage 2:
  ;; token list -> AST -> eval result

  (let parse_until
    (fn (tokens i acc)
      (let tok (nth tokens i))

      (if (eq tok ")")
        (list acc (add i 1))

        (if (eq tok "(")
          (begin
            (let nested (parse_until tokens (add i 1) (list)))
            (let nested_raw (nth nested 0))
            (let nested_ast (slice nested_raw 1 (len nested_raw)))
            (let next_i (nth nested 1))
            (parse_until tokens next_i (concat acc (list nested_ast)))
          )

          (parse_until tokens (add i 1) (concat acc (list tok)))
        )
      )
    )
  )

  (let parse
    (fn (tokens)
      (let first (nth tokens 0))

      (if (eq first "(")
        (begin
          (let parsed (parse_until tokens 1 (list)))
          (let raw (nth parsed 0))
          (slice raw 1 (len raw))
        )
        first
      )
    )
  )

  (let is_list
    (fn (x)
      (gt (len x) 0)
    )
  )

  (let eval_ast
    (fn (ast)
      (let op (nth ast 0))
      (let a (nth ast 1))
      (let b (nth ast 2))

      (let av
        (if (is_list a)
          (eval_ast a)
          a
        )
      )

      (let bv
        (if (is_list b)
          (eval_ast b)
          b
        )
      )

      (if (eq op "add")
        (add av bv)
        (if (eq op "mul")
          (mul av bv)
          0
        )
      )
    )
  )

  (let flat_tokens
    (list "(" "add" 2 3 ")")
  )

  (let nested_tokens
    (list "(" "add" 1 "(" "mul" 2 3 ")" ")")
  )

  (let flat_ast (parse flat_tokens))
  (let nested_ast (parse nested_tokens))

  (list
    "flat_ast" flat_ast
    "flat_result" (eval_ast flat_ast)
    "nested_ast" nested_ast
    "nested_result" (eval_ast nested_ast)
  )
)
