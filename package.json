{
  "name": "minicompiler",
  "version": "1.1.0",
  "type": "module",
  "scripts": {
    "build:msi": "powershell -NoProfile -ExecutionPolicy Bypass -File ./installer/build_msi.ps1",
    "build:release": "powershell -NoProfile -ExecutionPolicy Bypass -File ./installer/build_release_package.ps1",
    "install:windows": "powershell -NoProfile -ExecutionPolicy Bypass -File ./install_windows.ps1",
    "serve": "node serve.js",
    "test": "npm run check && npm run conformance && npm run errors",
    "simla": "node tools/run_js_vm.js",
    "check": "./tools/check_all.sh",
    "conformance": "./tools/conformance_check.sh",
    "errors": "./tools/error_conformance_check.sh"
  },
  "dependencies": {
    "@gltf-transform/core": "^4.3.0",
    "@gltf-transform/extensions": "^4.3.0",
    "draco3dgltf": "^1.5.7"
  }
}
